rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'm.mumba8@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection Health Check endpoint
    match /test/connection {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registered users profiles and verification records
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Geographic datasets (Read globally, write by Admin)
    match /countries/{countryCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow read: if true;
      allow create, update: if isValidId(businessId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 200;
      allow delete: if isAdmin();
    }

    // Professionals directory
    match /professionals/{professionalId} {
      allow read: if true;
      allow create, update: if isValidId(professionalId);
      allow delete: if isAdmin();
    }

    // Civic and commercial events
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId);
      allow delete: if isAdmin();
    }

    // Tenders and opportunities
    match /opportunities/{opportunityId} {
      allow read: if true;
      allow create, update: if isValidId(opportunityId);
      allow delete: if isAdmin();
    }

    // Customer & Merchant Orders (buy products, track dispatch)
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId);
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isValidId(reviewId) &&
        request.resource.data.businessId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // Verification requests collection
    match /verifications/{verificationId} {
      allow read: if true;
      allow create, update: if isValidId(verificationId);
      allow delete: if isAdmin();
    }

    // Audit logs collection (Append only)
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) &&
        request.resource.data.action is string;
      allow update, delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId);
    }

    // Courier fleet tracking
    match /couriers/{courierId} {
      allow read: if true;
      allow create, update, delete: if isValidId(courierId);
    }

    // Passenger Ride Requests
    match /rides/{rideId} {
      allow read: if true;
      allow create, update, delete: if isValidId(rideId);
    }

    // Bwana Wallet Transactions
    match /walletTransactions/{transactionId} {
      allow read: if true;
      allow create, update: if isValidId(transactionId);
      allow delete: if isAdmin();
    }

    // Bwana Scout Vendor Submissions
    match /scouts/{scoutId} {
      allow read: if true;
      allow create, update, delete: if isValidId(scoutId);
    }

    // Default deny for unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
